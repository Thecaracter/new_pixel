# Kantor Virtual — Environment Configuration
# Salin file ini menjadi .env jika ingin mengubah pengaturan default

# Backend Express Port (default: 3001)
BACKEND_PORT=3001

# Model OpenCode yang tersedia (pisahkan dengan koma)
# Kosongkan untuk menggunakan daftar model bawaan
OPENCODE_MODELS=9router/claude-haiku-4.5-thinking-agentic,9router/claude-opus-4-1-latest,9router/claude-sonnet-4-20250514

# Lokasi penyimpanan data JSON lokal (opsional, default: data/)
# CHAT_STORAGE_FILE=data/chat_history.json
# KANBAN_STORAGE_FILE=data/kanban.json

# Environment mode (development / production)
NODE_ENV=development
